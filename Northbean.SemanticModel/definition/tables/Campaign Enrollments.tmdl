	partition 'Campaign Enrollments' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_campaign_enrollments.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"EnrollmentID", Int64.Type}, {"CampaignID", Int64.Type}, {"MemberID", Int64.Type}, {"EnrolledDate", type date}, {"CompletedDate", type date}, {"PointsAwarded", Int64.Type}}, "en-US")
				in
