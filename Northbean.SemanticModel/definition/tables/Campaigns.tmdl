	partition Campaigns = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_campaign.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"CampaignID", Int64.Type}, {"CampaignName", type text}, {"Mechanic", type text}, {"CampaignType", type text}, {"StartDate", type date}, {"EndDate", type date}, {"RewardPoints", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
