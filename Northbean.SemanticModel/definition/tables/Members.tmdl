	partition Members = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_member.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"MemberID", Int64.Type}, {"JoinDate", type date}, {"JoinChannel", type text}, {"AgeBand", type text}, {"Tier", type text}, {"HomeStoreID", Int64.Type}}, "en-US")
				in
				    Typed

