	partition Redemptions = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_redemptions.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"RedemptionID", Int64.Type}, {"Date", type date}, {"MemberID", Int64.Type}, {"StoreID", Int64.Type}, {"RewardID", Int64.Type}, {"PointsSpent", Int64.Type}, {"RewardCost", type number}, {"DiscountValue", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
