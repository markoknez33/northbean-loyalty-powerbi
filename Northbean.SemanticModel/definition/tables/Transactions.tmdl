	column 'Customer Type' = IF ( ISBLANK ( Transactions[MemberID] ), "Guest", "Member" )
		dataType: string
		lineageTag: 3c7f7c8e-abe5-5bd3-ad21-53dfacdb38d9
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Months Since Join' = ```
			VAR _join = RELATED ( 'Members'[JoinDate] )
			RETURN
			    IF (
			        NOT ISBLANK ( _join ),
			        ( YEAR ( Transactions[Date] ) - YEAR ( _join ) ) * 12
			            + MONTH ( Transactions[Date] ) - MONTH ( _join )
			    )
			```
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 286a65c3-5c4a-5ff9-b6ef-9e3014d24186
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition Transactions = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_transactions.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"TransactionID", Int64.Type}, {"Date", type date}, {"Hour", Int64.Type}, {"StoreID", Int64.Type}, {"MemberID", Int64.Type}, {"Channel", type text}, {"Items", Int64.Type}, {"HasFood", Int64.Type}, {"GrossSales", type number}, {"Discount", type number}, {"NetSales", type number}, {"PointsEarned", Int64.Type}, {"RedemptionID", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
