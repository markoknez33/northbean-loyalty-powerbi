	measure 'Scope Label' = ```
			VAR _r = IF ( ISFILTERED ( Stores[Region] ), CONCATENATEX ( VALUES ( Stores[Region] ), Stores[Region], ", " ), "All regions" )
			VAR _f = IF ( ISFILTERED ( Stores[Format] ), CONCATENATEX ( VALUES ( Stores[Format] ), Stores[Format], ", " ), "all formats" )
			RETURN _r & "  ·  " & _f & "  ·  " & FORMAT ( DISTINCTCOUNT ( Transactions[StoreID] ), "0" ) & " stores"
