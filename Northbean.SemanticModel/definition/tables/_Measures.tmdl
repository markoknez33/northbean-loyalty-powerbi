	measure 'Participant Spend / Member' = ```
			VAR _campaigns =
			    FILTER ( VALUES ( Campaigns[CampaignID] ), CALCULATE ( COUNTROWS ( 'Campaign Enrollments' ) ) > 0 )
			VAR _rows =
			    ADDCOLUMNS (
			        _campaigns,
			        "@start", CALCULATE ( MIN ( Campaigns[StartDate] ) ),
			        "@end", CALCULATE ( MAX ( Campaigns[EndDate] ) ),
			        "@spend",
			            VAR _s = CALCULATE ( MIN ( Campaigns[StartDate] ) )
			            VAR _e = CALCULATE ( MAX ( Campaigns[EndDate] ) )
			            VAR _p = CALCULATETABLE ( VALUES ( 'Campaign Enrollments'[MemberID] ), REMOVEFILTERS ( Calendar ) )
			            RETURN
			                CALCULATE ( [Net Sales], TREATAS ( _p, Transactions[MemberID] ), REMOVEFILTERS ( Calendar ), DATESBETWEEN ( Calendar[Date], _s, _e ) ),
			        "@members", CALCULATE ( DISTINCTCOUNT ( 'Campaign Enrollments'[MemberID] ), REMOVEFILTERS ( Calendar ) )
			    )
			RETURN
			    DIVIDE ( SUMX ( _rows, [@spend] ), SUMX ( _rows, [@members] ) )
			```
		formatString: €#,0.00
		displayFolder: Campaigns
		lineageTag: 11862602-df1f-5030-b6f2-f5031be50bc8

	measure 'Non-participant Spend / Member' = ```
			VAR _campaigns =
			    FILTER ( VALUES ( Campaigns[CampaignID] ), CALCULATE ( COUNTROWS ( 'Campaign Enrollments' ) ) > 0 )
			VAR _rows =
			    ADDCOLUMNS (
			        _campaigns,
			        "@start", CALCULATE ( MIN ( Campaigns[StartDate] ) ),
			        "@end", CALCULATE ( MAX ( Campaigns[EndDate] ) ),
			        "@spend",
			            VAR _s = CALCULATE ( MIN ( Campaigns[StartDate] ) )
			            VAR _e = CALCULATE ( MAX ( Campaigns[EndDate] ) )
			            VAR _p = CALCULATETABLE ( VALUES ( 'Campaign Enrollments'[MemberID] ), REMOVEFILTERS ( Calendar ) )
			            VAR _active =
			                CALCULATETABLE (
			                    VALUES ( Transactions[MemberID] ),
			                    REMOVEFILTERS ( Calendar ),
			                    DATESBETWEEN ( Calendar[Date], _s, _e ),
			                    NOT ISBLANK ( Transactions[MemberID] )
			                )
			            VAR _non = EXCEPT ( _active, _p )
			            RETURN
			                CALCULATE ( [Net Sales], TREATAS ( _non, Transactions[MemberID] ), REMOVEFILTERS ( Calendar ), DATESBETWEEN ( Calendar[Date], _s, _e ) ),
			        "@members",
			            VAR _s = CALCULATE ( MIN ( Campaigns[StartDate] ) )
			            VAR _e = CALCULATE ( MAX ( Campaigns[EndDate] ) )
			            VAR _p = CALCULATETABLE ( VALUES ( 'Campaign Enrollments'[MemberID] ), REMOVEFILTERS ( Calendar ) )
			            VAR _active =
			                CALCULATETABLE (
			                    VALUES ( Transactions[MemberID] ),
			                    REMOVEFILTERS ( Calendar ),
			                    DATESBETWEEN ( Calendar[Date], _s, _e ),
			                    NOT ISBLANK ( Transactions[MemberID] )
			                )
			            RETURN COUNTROWS ( EXCEPT ( _active, _p ) )
			    )
			RETURN
			    DIVIDE ( SUMX ( _rows, [@spend] ), SUMX ( _rows, [@members] ) )
			```
		formatString: €#,0.00
		displayFolder: Campaigns
		lineageTag: 8fcc673b-1288-5a4d-a233-3818bd1c9f82

	measure 'Spend Uplift %' = ```
