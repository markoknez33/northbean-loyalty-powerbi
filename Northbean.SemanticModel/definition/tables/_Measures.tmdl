	measure 'Returning Members %' = ```
			-- share of members active in the previous, equally long period who came back in the selected period
			VAR _start = MIN ( Calendar[Date] )
			VAR _end = MAX ( Calendar[Date] )
			VAR _len = INT ( _end - _start ) + 1
			VAR _prev =
			    CALCULATETABLE (
			        VALUES ( Transactions[MemberID] ),
			        REMOVEFILTERS ( Calendar ),
			        DATESBETWEEN ( Calendar[Date], _start - _len, _start - 1 ),
			        NOT ISBLANK ( Transactions[MemberID] )
			    )
			VAR _curr =
			    CALCULATETABLE ( VALUES ( Transactions[MemberID] ), NOT ISBLANK ( Transactions[MemberID] ) )
			VAR _firstData = CALCULATE ( MIN ( Transactions[Date] ), REMOVEFILTERS () )
			RETURN
			    IF ( _start - _len >= _firstData, DIVIDE ( COUNTROWS ( INTERSECT ( _prev, _curr ) ), COUNTROWS ( _prev ) ) )
			```
		formatString: 0.0%
		displayFolder: Members
		lineageTag: 21628867-6eb9-52cd-ba91-ac84ed34b989

	measure 'At-Risk Members' = ```
			-- members whose last visit was 45-120 days before the end of the selected period
			VAR _end = MAX ( Calendar[Date] )
			VAR _lastVisit =
			    CALCULATETABLE (
			        ADDCOLUMNS (
			            VALUES ( Transactions[MemberID] ),
			            "@last", CALCULATE ( MAX ( Transactions[Date] ) )
			        ),
			        REMOVEFILTERS ( Calendar ),
			        Calendar[Date] <= _end,
			        NOT ISBLANK ( Transactions[MemberID] )
			    )
			RETURN
			    COUNTROWS ( FILTER ( _lastVisit, [@last] <= _end - 45 && [@last] > _end - 120 ) ) + 0
			```
		formatString: #,0
		displayFolder: Members
		lineageTag: 9165bda1-987d-5aa7-8ba7-d601d8b6f46c

	measure 'Cohort Retention %' = ```
			VAR _offset = SELECTEDVALUE ( 'Cohort Offset'[Month Offset] )
			VAR _cohortStart = MIN ( 'Members'[Join Month Start] )
			VAR _lastMonth = EOMONTH ( CALCULATE ( MAX ( Transactions[Date] ), REMOVEFILTERS () ), -1 ) + 1
			VAR _size = CALCULATE ( COUNTROWS ( 'Members' ), REMOVEFILTERS ( Calendar ) )
			VAR _active =
			    CALCULATE (
			        DISTINCTCOUNTNOBLANK ( Transactions[MemberID] ),
			        REMOVEFILTERS ( Calendar ),
			        Transactions[Months Since Join] = _offset
			    )
			RETURN
			    IF (
			        NOT ISBLANK ( _offset )
			            && _cohortStart >= DATE ( 2025, 1, 1 )
			            && EDATE ( _cohortStart, _offset ) <= _lastMonth,
			        DIVIDE ( _active, _size ) + 0
			    )
			```
		formatString: 0%
		displayFolder: Members
		lineageTag: 28b8e234-d0ee-568d-b73a-f6b51d6a5583

