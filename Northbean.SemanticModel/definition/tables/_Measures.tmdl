	measure 'Headline Overview' = ```
			VAR _d = [Net Sales Δ]
			RETURN
			    [Compact Net Sales] & " net sales"
			        & IF ( NOT ISBLANK ( _d ), " (" & IF ( _d >= 0, "+", "−" ) & FORMAT ( ABS ( _d ), "0%" ) & " vs PY)" )
			        & "  ·  members drive " & FORMAT ( [Member Sales Share %], "0%" ) & " of revenue"
			        & "  ·  members spend " & FORMAT ( [Member Ticket Uplift %], "0%" ) & " more per visit than guests"
			```
		displayFolder: UX
